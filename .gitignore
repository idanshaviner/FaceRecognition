### Private training data ###
# Keep the folder structure visible in git (.gitkeep placeholders) but
# never commit the actual photos/videos/frames - these are personal
# biometric data.
data/*
!data/idan/
!data/unknown/
data/idan/*
!data/idan/.gitkeep
data/unknown/*
!data/unknown/.gitkeep

### Trained model ###
# Contains data derived from your face photos - keep it local, regenerate
# with Trainer instead of committing it.
models/model.xml
